# Copy to .env locally; never commit real credentials.
DISCORD_BOT_TOKEN=replace-with-test-bot-token
DISCORD_GUILD_ID=123456789012345678
DISCORD_OPERATOR_ROLE_ID=123456789012345679
DATABASE_URL=postgresql+psycopg://jdr:jdr@localhost:5432/jdr
BOT_TIMEZONE=UTC

# Optional meetings-channel fallback for /config view. /config set stores and
# validates it. /meeting create does not read this value or the stored meetings
# channel, and still requires a text channel. This is not a secret.
# MEETINGS_CHANNEL_ID=123456789012345681

# Morning brief stays off while these lines are commented out.
# Uncomment the whole group together. Partial configuration fails startup.
# BRIEF_TIME is HH:MM local time. 09:00 is the provisional morning.
# BRIEF_CHANNEL_ID and BRIEF_TIME are the fallback when /config has not stored
# a brief channel or brief time. A stored value wins until an operator clears it.
# Jira token and email stay in this file. They are not stored in PostgreSQL.
# JIRA_JQL, when set, replaces the project/status query and is not logged.
# Use a Jira user that cannot edit issues. Do not commit a real token.
# BRIEF_CHANNEL_ID=123456789012345680
# BRIEF_TIME=09:00
# JIRA_BASE_URL=https://example.atlassian.net
# JIRA_PROJECT_KEY=JDR
# JIRA_STATUS_NAMES=In Progress
# JIRA_JQL=
# JIRA_USER_EMAIL=person@example.com
# JIRA_API_TOKEN=replace-with-jira-api-token
